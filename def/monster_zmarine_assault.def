model model_monster_zmarine_assault {
	inherit 						model_monster_zsec_shotgun
	mesh							models/md5/monsters/zombies/zmarine_assault/zmarine_assault.md5mesh
	channel torso					( *Waist )
	channel legs					( origin Body Body2 *Hips -*Waist SPINNER )
}

