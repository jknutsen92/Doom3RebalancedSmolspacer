// The range of potential scores that can spawn on a given map's base score is given by g_skill.
// Lower difficulty range is skewed more to the lower end of scores and higher difficulty range
// is skewed more to the higher end of scores
entityDef skill_resurrector_range {
    "lower_0"   "-30"       // [-30,-10]    Recruit
    "upper_0"   "-10"
    "lower_1"   "-20"       // [-20,0]      Marine
    "upper_1"   "0"
    "lower_2"   "-10"       // [-10,10]     Veteran
    "upper_2"   "10"
    "lower_3"   "-10"       // [-10,10]     Nightmare
    "upper_3"   "10"
}