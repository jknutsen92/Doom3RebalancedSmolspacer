// The base score determines the center of the range of monsters that can be selected for resurrection
// When combined with the spread determined by g_skill in the skill_resurrect_range table, you get a range 
// of scores that will determine what monsters can be spawned on any given map at a given difficulty level
entityDef map_resurrector_score {
    "mars_city1"        "0"
    "mc_underground"    "6"
    "mars_city2"        "10"
    "admin"             "14"
    "alphalabs1"        "18"
    "alphalabs2"        "20"
    "alphalabs3"        "23"
    "alphalabs4"        "27"
