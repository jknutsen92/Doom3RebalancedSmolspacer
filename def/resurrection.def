    "commoutside"       "32"
    "comm1"             "34"
    "recycling1"        "36"
    "recycling2"        "38"
    "monorail"          "40"
    "delta1"            "41"
    "delta2a"           "43"
    "delta2b"           "45"
    "delta3"            "47"
    "delta4"            "49"
    "hell1"             "50"
    "delta5"            "52"
    "cpu"               "54"
    "cpuboss"           "54"
    "site3"             "60"
    "caverns1"          "60"
    "caverns2"          "60"
    "hellhole"          "60"
