models/mapobjects/alphalabs3/vagary/vagary_mummy_heated {
	noselfshadow
	flesh
		renderbump  -size 128 256 -aa 2 -colormap models/mapobjects/alphalabs3/vagary/vagary_mummy_local.tga models/mapobjects/alphalabs3/vagary/work/vagary_mummy_hp.lwo
		bumpmap		addnormals (models/mapobjects/alphalabs3/vagary/vagary_mummy_local, heightmap (models/mapobjects/alphalabs3/vagary/vagary_mummy_bmp.tga, 4) )
		diffusemap	models/mapobjects/alphalabs3/vagary/vagary_mummy
		specularmap	models/mapobjects/alphalabs3/vagary/vagary_mummy_s
	{
		blend   add
		color   0.3 * parm11, 0, 0.06 * parm11, 1
		map     lights/fullambient.tga
	}
	{	// burning corpse effect
		if	parm7			// only when dead
		// make a burned away alpha test for the normal skin
		blend	gl_zero, gl_one			// don't draw anything
		
		map models/monsters/spectre/global_dis.tga	// replace this with a monster-specific texture
		alphaTest 0.05 + 1.5 * (time - parm7)
    }
	{
		if parm7			// only when dead
		privatePolygonOffset	-1		// stage-only polygon offset
		blend add
		blend gl_one, gl_zero
		map models/monsters/vagary/vagary_dis.tga
		alphaTest 3.6 * (time - parm7)
	}
}

models/characters/male_npc/hazmat/hazmat_heated {
	noselfShadow
	clamp
	unsmoothedTangents
	flesh
	forceOverlays
	renderbump  -size 1024 1024 -trace 0.07 -colorMap -aa 2   models/characters/male_npc/hazmat/hazmat_local.tga models/characters/male_npc/hazmat/hazmat_hi.lwo
	diffusemap	  models/characters/male_npc/hazmat/hazmat.tga
	{
		blend bumpmap
		map  addnormals(models/characters/male_npc/hazmat/hazmat_local.tga, heightmap(models/characters/male_npc/hazmat/hazmat_h.tga, 2 ) )
		
	}
	specularmap	models/characters/male_npc/hazmat/hazmat_s.tga
	{
		blend   add
		color   0.3 * parm11, 0, 0.06 * parm11, 1
		map     lights/fullambient.tga
	}
	{	// burning corpse effect
		if	parm7			// only when dead
		// make a burned away alpha test for the normal skin
		blend	gl_zero, gl_one			// don't draw anything
		
		map models/monsters/spectre/global_dis.tga	// replace this with a monster-specific texture
		alphaTest 0.05 + 1.5 * (time - parm7)
	}
	{
		if parm7			// only when dead
		privatePolygonOffset	-1		// stage-only polygon offset
		blend add
		blend gl_one, gl_zero
		map models/monsters/vagary/vagary_dis.tga
		alphaTest 3.6 * (time - parm7)
	}
}

models/characters/male_npc/hazmat/visor_heated {
	noselfShadow
	noShadows
	unsmoothedTangents
	translucent
	renderbump  -size 128 128 -trace 0.07 -colorMap -aa 4   models/characters/male_npc/hazmat/visor_local.tga models/characters/male_npc/hazmat/visor_hi.lwo
	{
		if ( parm7 == 0 )
		blend bumpmap
		map  models/characters/male_npc/hazmat/visor_local.tga
	}
	{
		if ( parm7 == 0 )
		blend  specularmap
		map models/characters/male_npc/hazmat/visor_s.tga
	}
	{
		if ( parm7 == 0 )
		blend add  //gl_dst_alpha , gl_one_minus_dst_alpha
		cubeMap		env/bland
		texgen		reflect
	}
	{
		blend   add
		color   0.3 * parm11, 0, 0.06 * parm11, 1
		map     lights/fullambient.tga
	}
	{	// burning corpse effect
		if	parm7			// only when dead
		// make a burned away alpha test for the normal skin
		blend	gl_zero, gl_one			// don't draw anything
		
		map models/monsters/spectre/global_dis.tga	// replace this with a monster-specific texture
		alphaTest 0.05 + 1.5 * (time - parm7)
	}
	{
		if parm7			// only when dead
		privatePolygonOffset	-1		// stage-only polygon offset
		blend add
		blend gl_one, gl_zero
		map models/monsters/vagary/vagary_dis.tga
		alphaTest 3.6 * (time - parm7)
	}
}

