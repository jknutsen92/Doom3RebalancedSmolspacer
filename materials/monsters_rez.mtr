models/monsters/zombie/bernie/berniefx_rez {
	noShadows
	noselfshadow
	flesh
	nonsolid
	noimpact
	translucent
	{
		if	( parm7 == 0 )
		maskcolor
		map makealpha(models/monsters/zombie/bernie/berniefx.tga)
		
	}
	{
		if	( parm7 == 0 )
		blend gl_dst_alpha, gl_one
		maskalpha
		map models/monsters/lost/lostfx.tga
		red   1
		blue  .5
		green .5
		translate	time * 0.2 , time * 1.1
	}
	{
		blend                   add
		rgb                     crackPulseTable[ time / 10 ]
		map                     models/lava.jpg
	}
}

