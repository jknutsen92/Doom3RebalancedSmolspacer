		diffusemap	    models/characters/common/tongue.tga
		bumpmap		addnormals(models/characters/common/tongue_local.tga, heightmap(models/characters/common/tongue_h.tga, 4 ) )
		specularmap		models/characters/common/tongue_s.tga
