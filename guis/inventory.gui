                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
                    }
                    
                }

                windowDef bulletsAmmoBarFill {
                    rect            AMMO_FILL_POS_X, AMMO_FILL_POS_Y, AMMO_FILL_WIDTH * "gui::player_bullets_ratio", AMMO_FILL_HEIGHT       // [0%,100%] => [0,446]

                    onEvent {
                        if ("gui::player_bullets_ratio" >= LOW_RATIO) {
                            set "backcolor" "$desktop::fullcolor";
                        }
                        else if ("gui::player_bullets_ratio" > CRIT_RATIO && "gui::player_bullets_ratio" < LOW_RATIO) {
                            set "backcolor" "$desktop::lowcolor";
                        }
                        else if ("gui::player_bullets_ratio" <= CRIT_RATIO) {
                            set "backcolor" "$desktop::critcolor";
                        }
                        
