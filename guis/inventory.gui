                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
                    }
                    
                }

                windowDef weaponIcon {
                    rect            WEAP_ICON_POS_X, WEAP_ICON_POS_Y, WEAP_ICON_WIDTH, WEAP_ICON_HEIGHT
                    background      "guis/assets/hud/icons/shotgunw"
                    matcolor        SHELLS_COLOR
                }

                windowDef classicClipFill {
                    rect            WEAP_FILL_POS_X, WEAP_FILL_POS_Y, WEAP_FILL_WIDTH * "gui::player_classic_clip_ratio", WEAP_FILL_HEIGHT

                    onEvent {
                        if ("gui::player_classic_clip_ratio" >= LOW_RATIO) {
                            set "backcolor" "$desktop::fullcolor" ;
                        }
                        else if ("gui::player_classic_clip_ratio" > CRIT_RATIO && "gui::player_classic_clip_ratio" < LOW_RATIO) {
                            set "backcolor" "$desktop::lowcolor" ;
                        }
                        else if ("gui::player_classic_clip_ratio" <= CRIT_RATIO) {
                            set "backcolor" "$desktop::critcolor" ;
                        }
                        
                    }
                }

                windowDef classicClipEmpty {
                    rect            WEAP_FILL_POS_X, WEAP_FILL_POS_Y, WEAP_FILL_WIDTH, WEAP_FILL_HEIGHT
                    backcolor       CRIT_COLOR

                    onEvent {
                        if ("gui::player_classic_clip" == 0) {
                            set "visible" "1";
                        }
                        else {
                            set "visible" "0";
                        }
                        
                    }
                }

                windowDef classicClipCount {
                    rect            WEAP_CLIP_COUNT_POS_X, WEAP_CLIP_COUNT_POS_Y, WEAP_CLIP_COUNT_WIDTH, WEAP_CLIP_COUNT_HEIGHT
                    text            "gui::player_classic_clip"
                    forecolor       SHELLS_COLOR
                    textscale       WEAP_CLIP_COUNT_TEXTSCALE
                    textalign       2

                    onEvent {
                        if ("gui::player_classic_clip" < 0) {
                            set "visible" "0";
                        }
                        else {
                            set "visible" "1";
                        }
                        
                    }
                }
            }

            windowDef shellsAmmoBar {
                rect            AMMO_BAR_POS_X, AMMO_BAR_POS_Y, AMMO_BAR_WIDTH, AMMO_BAR_HEIGHT
                backcolor       NEUTRAL_BAR_BACKGROUND
                bordersize      2
                bordercolor     SHELLS_COLOR

                onEvent {
                    if ("gui::player_shells_posession" == 1) {
                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
                    }
                    
                }

                windowDef shellsAmmoBarFill {
                    rect            AMMO_FILL_POS_X, AMMO_FILL_POS_Y, AMMO_FILL_WIDTH * "gui::player_shells_ratio", AMMO_FILL_HEIGHT    // [0%,100%] => [0,446]

                    onEvent {
                        if ("gui::player_shells_ratio" >= LOW_RATIO) {
                            set "backcolor" "$desktop::fullcolor";
                        }
                        else if ("gui::player_shells_ratio" > CRIT_RATIO && "gui::player_bullets_ratio" < LOW_RATIO) {
                            set "backcolor" "$desktop::lowcolor";
                        }
                        else if ("gui::player_shells_ratio" <= CRIT_RATIO) {
                            set "backcolor" "$desktop::critcolor";
                        }
                        
                    }
                }

                windowDef shellsAmmoBarEmpty {
                    rect            AMMO_FILL_POS_X, AMMO_FILL_POS_Y, AMMO_FILL_WIDTH, AMMO_FILL_HEIGHT
                    backcolor       CRIT_COLOR

                    onEvent {
                        if ("gui::player_shells_count" == 0) {
                            set "visible" "1";
                        }
                        else {
                            set "visible" "0";
                        }
                        
