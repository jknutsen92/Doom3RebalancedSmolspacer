                    text            "BFG CELLS"
                    forecolor       BFG_COLOR
                    textscale       BFGCELL_NAME_TEXTSCALE
                }

                windowDef ammoCount {
                    rect        BFG_AMMO_COUNT_POS_X, BFG_AMMO_COUNT_POS_Y, BFG_AMMO_COUNT_WIDTH, BFG_AMMO_COUNT_HEIGHT
                    text        "gui::player_bfgcell_count"
                    forecolor   BFG_COLOR
                    textscale   BFG_AMMO_COUNT_TEXTSCALE
                    textalign   2
                }
            }
        }

        windowDef soulCubeCategory {
            rect        SOULCUBE_CATEGORY_POS_X, SOULCUBE_CATEGORY_POS_Y, SOULCUBE_CATEGORY_WIDTH, SOULCUBE_CATEGORY_HEIGHT

            windowDef secretChainsawIcon {
                rect        SOULCUBE_SECRET_ICON_POS_X, SOULCUBE_SECRET_ICON_POS_Y, SOULCUBE_SECRET_ICON_WIDTH, SOULCUBE_SECRET_ICON_HEIGHT
                background  "guis/assets/hud/icons/chainsaw_icon"
                matcolor    SECRET_CHAINSAW_COLOR
                visible     0
            }

            windowDef soulCube {
                rect        SOULCUBE_PANE_POS_X, SOULCUBE_PANE_POS_Y, SOULCUBE_PANE_WIDTH, SOULCUBE_PANE_HEIGHT
                backcolor   NEUTRAL_BAR_BACKGROUND
                bordersize  2
                bordercolor SOUL_CUBE_COLOR

                onEvent {
                    if ("gui::player_soulcube_posession" == 1) {
                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
                    }
                }

                windowDef icon {
                    rect        SOULCUBE_ICON_POS_X, SOULCUBE_ICON_POS_Y, SOULCUBE_ICON_WIDTH, SOULCUBE_ICON_HEIGHT
                    background  "guis/assets/hud/icons/scubew.tga"
                    matcolor    SOUL_CUBE_COLOR
                }

                windowDef soulsFill {
                    rect        SOULCUBE_FILL_POS_X, SOULCUBE_FILL_POS_Y * (1 - "gui::player_soulcube_ratio"), SOULCUBE_FILL_WIDTH, SOULCUBE_FILL_HEIGHT * "gui::player_soulcube_ratio"

                    onEvent {
                        if ("gui::player_soulcube_ratio" >= LOW_RATIO) {
                            set "backcolor" "$desktop::fullcolor" ;
                        }
                        else if ("gui::player_soulcube_ratio" > CRIT_RATIO && "gui::player_soulcube_ratio" < LOW_RATIO) {
                            set "backcolor" "$desktop::lowcolor" ;
                        }
                        else if ("gui::player_soulcube_ratio" <= CRIT_RATIO) {
                            set "backcolor" "$desktop::critcolor" ;
                        }
                    }
                }

                windowDef soulsEmpty {
                    rect            SOULCUBE_FILL_POS_X, SOULCUBE_FILL_POS_Y, SOULCUBE_FILL_WIDTH, SOULCUBE_FILL_HEIGHT
                    backcolor       CRIT_COLOR

                    onEvent {
                        if ("gui::player_soul_count" == 0) {
                            set "visible" "1";
                        }
                        else {
                            set "visible" "0";
                        }
                    }
                }
            }
        }
    }
}