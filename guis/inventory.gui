                            set "backcolor" "$desktop::fullcolor" ;
                        }
                        else if ("gui::player_shotgun_clip_ratio" > CRIT_RATIO && "gui::player_shotgun_clip_ratio" < LOW_RATIO) {
                            set "backcolor" "$desktop::lowcolor" ;
                        }
                        else if ("gui::player_shotgun_clip_ratio" <= CRIT_RATIO) {
