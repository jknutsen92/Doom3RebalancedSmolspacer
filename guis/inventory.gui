#define SOULCUBE_ICON_HEIGHT        56
#define SOULCUBE_ICON_POS_X         0
#define SOULCUBE_ICON_POS_Y         0

#define SOULCUBE_FILL_WIDTH         56
#define SOULCUBE_FILL_HEIGHT        56
#define SOULCUBE_FILL_POS_X         0
#define SOULCUBE_FILL_POS_Y         58

windowDef Desktop {
    rect            0, 0, 640, 480
    visible         1
    nocursor        1
    backcolor       0, 0, 0, 0
    visible         1

    definevec4  "fullcolor" FULL_COLOR 
    definevec4  "lowcolor"  LOW_COLOR
    definevec4  "critcolor" CRIT_COLOR

    windowDef standardWeapons {
        rect            MAIN_WEAPONS_PANE_POS_X, MAIN_WEAPONS_PANE_POS_Y, MAIN_WEAPONS_PANE_WIDTH, MAIN_WEAPONS_PANE_HEIGHT
        backcolor       0, 0, 0, 0
        textscale       0.2
        visible         1

        windowDef bulletsCategory {
            rect            0, 0, AMMO_CATEGORY_WIDTH, AMMO_CATEGORY_HEIGHT
            backcolor       0, 0, 0, 0
            textscale       0.2

            windowDef weaponPistol {
                rect            WEAP_PANE_1_POS_X, WEAP_PANE_1_POS_Y, WEAP_PANE_WIDTH, WEAP_PANE_HEIGHT
                bordersize      2
                bordercolor     BULLETS_COLOR
                backcolor       NEUTRAL_BAR_BACKGROUND

                onEvent {
                    if ("gui::player_pistol_posession" == 1) {
                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
                    }
                    
                }

                windowDef weaponIcon {
                    rect            WEAP_ICON_POS_X, WEAP_ICON_POS_Y, WEAP_ICON_WIDTH, WEAP_ICON_HEIGHT
                    background      "guis/assets/hud/icons/pistolw"
                    matcolor        BULLETS_COLOR
                }

                windowDef pistolClipFill {
                    rect            WEAP_FILL_POS_X, WEAP_FILL_POS_Y, WEAP_FILL_WIDTH * "gui::player_pistol_clip_ratio", WEAP_FILL_HEIGHT

                    onEvent {
                        if ("gui::player_pistol_clip_ratio" >= LOW_RATIO) {
                            set "backcolor" "$desktop::fullcolor" ;
                        }
                        else if ("gui::player_pistol_clip_ratio" > CRIT_RATIO && "gui::player_pistol_clip_ratio" < LOW_RATIO) {
                            set "backcolor" "$desktop::lowcolor" ;
                        }
                        else if ("gui::player_pistol_clip_ratio" <= CRIT_RATIO) {
                            set "backcolor" "$desktop::critcolor" ;
                        }
                        
                    }
                }

                windowDef pistolClipEmpty {
                    rect            WEAP_FILL_POS_X, WEAP_FILL_POS_Y, WEAP_FILL_WIDTH, WEAP_FILL_HEIGHT
                    backcolor       CRIT_COLOR

                    onEvent {
                        if ("gui::player_pistol_clip" == 0) {
                            set "visible" "1";
                        }
                        else {
                            set "visible" "0";
                        }
                        
                    }
                }

                windowDef pistolClipCount {
                    rect            WEAP_CLIP_COUNT_POS_X, WEAP_CLIP_COUNT_POS_Y, WEAP_CLIP_COUNT_WIDTH, WEAP_CLIP_COUNT_HEIGHT
                    text            "gui::player_pistol_clip"
                    forecolor       BULLETS_COLOR
                    textscale       WEAP_CLIP_COUNT_TEXTSCALE
                    textalign       2

                    onEvent {
                        if ("gui::player_pistol_clip" < 0) {
                            set "visible" "0";
                        }
                        else {
                            set "visible" "1";
                        }
                        
                    }
                }
            }

            windowDef bulletsAmmoBar {
                rect            AMMO_BAR_POS_X, AMMO_BAR_POS_Y, AMMO_BAR_WIDTH, AMMO_BAR_HEIGHT
                backcolor       NEUTRAL_BAR_BACKGROUND
                bordersize      2
                bordercolor     BULLETS_COLOR

                onEvent {
                    if ("gui::player_bullets_posession" == 1) {
                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
                    }
                    
                }

                windowDef bulletsAmmoBarFill {
                    rect            AMMO_FILL_POS_X, AMMO_FILL_POS_Y, AMMO_FILL_WIDTH * "gui::player_bullets_ratio", AMMO_FILL_HEIGHT       // [0%,100%] => [0,446]

                    onEvent {
                        if ("gui::player_bullets_ratio" >= LOW_RATIO) {
                            set "backcolor" "$desktop::fullcolor";
                        }
                        else if ("gui::player_bullets_ratio" > CRIT_RATIO && "gui::player_bullets_ratio" < LOW_RATIO) {
                            set "backcolor" "$desktop::lowcolor";
                        }
                        else if ("gui::player_bullets_ratio" <= CRIT_RATIO) {
                            set "backcolor" "$desktop::critcolor";
                        }
                        
                    }
                }

                windowDef bulletsAmmoBarEmpty {
                    rect            AMMO_FILL_POS_X, AMMO_FILL_POS_Y, AMMO_FILL_WIDTH, AMMO_FILL_HEIGHT
                    backcolor       CRIT_COLOR

                    onEvent {
                        if ("gui::player_bullets_count" == 0) {
                            set "visible" "1";
                        }
                        else {
                            set "visible" "0";
                        }
                        
                    }
                }

                windowDef ammoBarName {
                    rect            AMMO_NAME_POS_X, AMMO_NAME_POS_Y, AMMO_NAME_WIDTH, AMMO_NAME_HEIGHT
                    text            "BULLETS"
                    textscale       AMMO_NAME_TEXTSCALE
                    forecolor       BULLETS_COLOR
                }

                windowDef ammoBarCount {
                    rect            AMMO_COUNT_POS_X, AMMO_COUNT_POS_Y, AMMO_COUNT_WIDTH, AMMO_COUNT_HEIGHT
                    text            "gui::player_bullets_count"
                    textscale       AMMO_COUNT_TEXTSCALE
                    textalign       2
                    forecolor       BULLETS_COLOR
                }
            }
        }

        windowDef shellsCategory {
            rect            0, AMMO_CATEGORY_STEP_Y, AMMO_CATEGORY_WIDTH, AMMO_CATEGORY_HEIGHT
            backcolor       0, 0, 0, 0
            textscale       0.2

            windowDef weaponShotgun {
                rect            WEAP_PANE_1_POS_X, WEAP_PANE_1_POS_Y, WEAP_PANE_WIDTH, WEAP_PANE_HEIGHT
                bordersize      2
                bordercolor     SHELLS_COLOR
                backcolor       NEUTRAL_BAR_BACKGROUND

                onEvent {
                    if ("gui::player_shotgun_posession" == 1) {
                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
