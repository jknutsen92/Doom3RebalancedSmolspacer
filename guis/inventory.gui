                }

                windowDef ammoBarName {
                    rect            AMMO_NAME_POS_X, AMMO_NAME_POS_Y, AMMO_NAME_WIDTH, AMMO_NAME_HEIGHT
                    text            "SHELLS"
                    textscale       AMMO_NAME_TEXTSCALE
                    forecolor       SHELLS_COLOR
                }

                windowDef ammoBarCount {
                    rect            AMMO_COUNT_POS_X, AMMO_COUNT_POS_Y, AMMO_COUNT_WIDTH, AMMO_COUNT_HEIGHT
                    text            "gui::player_shells_count"
                    textscale       AMMO_COUNT_TEXTSCALE
                    textalign       2
                    forecolor       SHELLS_COLOR
                }
            }
        }

        windowDef clipCategory {
            rect            0, AMMO_CATEGORY_STEP_Y * 2, AMMO_CATEGORY_WIDTH, AMMO_CATEGORY_HEIGHT
            backcolor       0, 0, 0, 0
            textscale       0.2
            visible         1

            windowDef weaponMachinegun {
                rect            WEAP_PANE_1_POS_X, WEAP_PANE_1_POS_Y, WEAP_PANE_WIDTH, WEAP_PANE_HEIGHT
                bordersize      2
                bordercolor     CLIP_COLOR
                backcolor       NEUTRAL_BAR_BACKGROUND

                onEvent {
                    if ("gui::player_machinegun_posession" == 1) {
                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
                    }
                    
