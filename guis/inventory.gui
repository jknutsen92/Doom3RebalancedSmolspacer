// Rects - Soulcube
#define SOULCUBE_CATEGORY_WIDTH     90
#define SOULCUBE_CATEGORY_HEIGHT    60
#define SOULCUBE_CATEGORY_POS_X     320
#define SOULCUBE_CATEGORY_POS_Y     0

#define SOULCUBE_SECRET_ICON_WIDTH  24
#define SOULCUBE_SECRET_ICON_HEIGHT 24
