// Fill colors
#define             CAP_FULL_COLOR              0.345,  0.635,  0.91,   0.5     // count% >= 40%
#define             CAP_LOW_COLOR               0.973,  1,      0.463,  0.5     // count% (15%,40%)
#define             CAP_CRITICAL_COLOR          1,      0.114,  0.114,  0.5     // count% <= 15%

// Matte background colors
#define             NEUTRAL_BAR_BACKGROUND      0.8,    0.8,    0.8,    1

// Borders and highlights
#define             BULLETS_COLOR               0.518,  0.012,  0.012,  1
#define             SHELLS_COLOR                0.29,   0.29,   0.29,   1
#define             CLIP_COLOR                  0,      0.455,  0.055,  1
#define             GRENADES_COLOR              0.427,  0,      0.514,  1
#define             BELT_COLOR                  0.643,  0.302,  0,      1
#define             CELLS_COLOR                 0,      0.008,  0.455,  1
#define             ROCKETS_COLOR               0.322,  0.137,  0,      1
#define             CHAINSAW_COLOR              0.51,   0,      0.231,  1
#define             BFG_COLOR                   0.031,  0.522,  0.4,    1
#define             SOUL_CUBE_COLOR             0.541,  0.239,  0,      1
#define             SECRET_CHAINSAW_COLOR       0.851,  0.212,  0,      1

windowDef Desktop {
    rect            0, 0, 640, 480
    visible         1
    nocursor        1
    backcolor       0, 0, 0, 0
    visible         1

    windowDef standardWeapons {
        rect            25, 20, 580, 360
        backcolor       0, 0, 0, 0
        textscale       0.2
        visible         1

        windowDef ammoCategory1 {
            rect            0, 0, 580, 48
            backcolor       0, 0, 0, 0
            textscale       0.2
            visible         1

            windowDef weapon1 {
                rect            64, 2, 60, 44
                bordersize      2
                bordercolor     BULLETS_COLOR
                backcolor       NEUTRAL_BAR_BACKGROUND

                windowDef weaponIcon {
                    rect            2, 1, 52, 36
                    background      "guis/assets/hud/icons/pistolw"
                    matcolor        BULLETS_COLOR
                }

                windowDef clipFill {
                    rect            0, 0, 56 * "gui::player_weapon1_clip_ratio", 40
                    backcolor       CAP_FULL_COLOR

                    onTime 0 {
                        if ("gui::player_weapon1_clip_ratio" >= 0.4) {
                            set "backcolor" "0.345, 0.635, 0.91, 0.5";
                        }
                        else if ("gui::player_weapon1_clip_ratio" > 0.15 && "gui::player_weapon1_clip_ratio" < 0.4) {
                            set "backcolor" "0.973,1, 0.463, 0.5";
                        }
                        else if ("gui::player_weapon1_clip_ratio" <= 0.15) {
                            set "backcolor" "1, 0.114, 0.114, 0.5";
                        }
                        resetTime "clipFill" "0";
                    }
                }

                windowDef clipCount {
                    rect            38, 24, 16, 8
                    text            "gui::player_weapon1_clip"
                    forecolor       BULLETS_COLOR
                        textscale       0.25
                        textalign       2
                }
            }

            windowDef ammoBar {
                rect        128, 6, 450, 36
                backcolor       NEUTRAL_BAR_BACKGROUND
                bordersize      2
                bordercolor     BULLETS_COLOR

                windowDef ammoBarFill {
                    rect            0, 0, 446 * "gui::player_bullets_ratio", 32               // [0%,100%] => [0,446]
                    backcolor       CAP_FULL_COLOR

                    onTime 0 {
                        if ("gui::player_bullets_ratio" >= 0.4) {
                            set "backcolor" "0.345, 0.635, 0.91, 0.5";
                        }
                        else if ("gui::player_bullets_ratio" > 0.15 && "gui::player_bullets_ratio" < 0.4) {
                            set "backcolor" "0.973,1, 0.463, 0.5";
                        }
                        else if ("gui::player_bullets_ratio" <= 0.15) {
                            set "backcolor" "1, 0.114, 0.114, 0.5";
                        }
                        resetTime "ammoBarFill" "0";
                    }
                }

                windowDef ammoBarName {
                    rect            8, 8, 128, 2
