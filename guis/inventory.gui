#define WEAP_PANE_HEIGHT            38
#define WEAP_PANE_1_POS_X           68
#define WEAP_PANE_1_POS_Y           2
#define WEAP_PANE_2_POS_X           14
#define WEAP_PANE_2_POS_Y           2

