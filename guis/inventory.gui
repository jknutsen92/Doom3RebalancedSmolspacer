#define FULL_COLOR                  0.145,  0.4,    0.361,  0.5
#define LOW_COLOR                   0.702,  0.533,  0.141,  0.5
#define CRIT_COLOR                  0.612,  0.118,  0.18,   0.5

// Matte background colors
#define NEUTRAL_BAR_BACKGROUND      0.1,    0.1,    0.1,    1

// Borders and highlights
#define BULLETS_COLOR               0.702,  0,      0,      1
#define SHELLS_COLOR                0.541,  0.541,  0.541,  1
#define CLIP_COLOR                  0.624,  0.78,   0.306,  1
#define GRENADES_COLOR              0.718,  0.263,  0.812,  1
#define BELT_COLOR                  0.788,  0.592,  0.165,  1
#define CELLS_COLOR                 0.176,  0.49,   0.851,  1
#define ROCKETS_COLOR               0.569,  0.71,   0.373,  1
#define CHAINSAW_COLOR              0.729,  0.408,  0.118,  1
#define BFG_COLOR                   0.212,  0.8,    0.541,  1
#define SOUL_CUBE_COLOR             0.851,  0.361,  0.114,  1
#define SECRET_CHAINSAW_COLOR       0.851,  0.212,  0,      1

// Styling logic
#define LOW_RATIO                   0.5
#define CRIT_RATIO                  0.20

// Rects - Main weapons section
#define MAIN_WEAPONS_PANE_WIDTH     580
#define MAIN_WEAPONS_PANE_HEIGHT    360
#define MAIN_WEAPONS_PANE_POS_X     25
#define MAIN_WEAPONS_PANE_POS_Y     20

// Rects - Ammo category
#define AMMO_CATEGORY_WIDTH         580
#define AMMO_CATEGORY_HEIGHT        48
#define AMMO_CATEGORY_STEP_Y        AMMO_CATEGORY_HEIGHT

// Rects - Weapon pane
#define WEAP_PANE_WIDTH             60
#define WEAP_PANE_HEIGHT            44
#define WEAP_PANE_1_POS_X           64
#define WEAP_PANE_1_POS_Y           2
#define WEAP_PANE_2_POS_X           0
#define WEAP_PANE_2_POS_Y           2

#define WEAP_ICON_WIDTH             52
#define WEAP_ICON_HEIGHT            36
#define WEAP_ICON_POS_X             2
#define WEAP_ICON_POS_Y             1

#define WEAP_FILL_WIDTH             56
#define WEAP_FILL_HEIGHT            40
#define WEAP_FILL_POS_X             0
#define WEAP_FILL_POS_Y             0

#define WEAP_CLIP_COUNT_WIDTH       16
#define WEAP_CLIP_COUNT_HEIGHT      16
#define WEAP_CLIP_COUNT_POS_X       38
#define WEAP_CLIP_COUNT_POS_Y       24
#define WEAP_CLIP_COUNT_TEXTSCALE   0.25

// Rects - Ammo bar
#define AMMO_BAR_WIDTH              450
#define AMMO_BAR_HEIGHT             36
#define AMMO_BAR_POS_X              128
#define AMMO_BAR_POS_Y              6

#define AMMO_FILL_WIDTH             446
#define AMMO_FILL_HEIGHT            32
#define AMMO_FILL_POS_X             0
#define AMMO_FILL_POS_Y             0

#define AMMO_NAME_WIDTH             128
#define AMMO_NAME_HEIGHT            2
#define AMMO_NAME_POS_X             8
#define AMMO_NAME_POS_Y             8
#define AMMO_NAME_TEXTSCALE         0.25

#define AMMO_COUNT_WIDTH            36
#define AMMO_COUNT_HEIGHT           24
#define AMMO_COUNT_POS_X            402
#define AMMO_COUNT_POS_Y            8
#define AMMO_COUNT_TEXTSCALE        0.25

// Rects - Special weapons
#define SPEC_WEAPONS_PANE_WIDTH     580
#define SPEC_WEAPONS_PANE_HEIGHT    108
#define SPEC_WEAPONS_PANE_POS_X     25
#define SPEC_WEAPONS_PANE_POS_Y     360

// Rects - Chainsaw
#define CHAINSAW_CATEGORY_WIDTH     172
#define CHAINSAW_CATEGORY_HEIGHT    108
#define CHAINSAW_CATEGORY_POS_X     0
#define CHAINSAW_CATEGORY_POS_Y     0

#define CHAINSAW_ICON_WIDTH         164
#define CHAINSAW_ICON_HEIGHT        106
#define CHAINSAW_ICON_POS_X         2
#define CHAINSAW_ICON_POS_Y         2

#define CHAINSAW_FILL_WIDTH         168
#define CHAINSAW_FILL_HEIGHT        104
#define CHAINSAW_FILL_POS_X         0
#define CHAINSAW_FILL_POS_Y         104

// Rects - BFG
#define BFG_CATEGORY_WIDTH          256
#define BFG_CATEGORY_HEIGHT         108
#define BFG_CATEGORY_POS_X          184
#define BFG_CATEGORY_POS_Y          0

#define BFG_WEAP_PANE_WIDTH         156
#define BFG_WEAP_PANE_HEIGHT        108
#define BFG_WEAP_PANE_POS_X         0
#define BFG_WEAP_PANE_POS_Y         0

#define BFG_WEAP_ICON_WIDTH         152
#define BFG_WEAP_ICON_HEIGHT        104
#define BFG_WEAP_ICON_POS_X         2
#define BFG_WEAP_ICON_POS_Y         2

#define BFG_WEAP_FILL_WIDTH         152
#define BFG_WEAP_FILL_HEIGHT        104
#define BFG_WEAP_FILL_POS_X         0
#define BFG_WEAP_FILL_POS_Y         0

windowDef Desktop {
    rect            0, 0, 640, 480
    visible         1
    nocursor        1
    backcolor       0, 0, 0, 0
    visible         1

    definevec4  "fullcolor" FULL_COLOR 
    definevec4  "lowcolor"  LOW_COLOR
    definevec4  "critcolor" CRIT_COLOR

    windowDef standardWeapons {
        rect            MAIN_WEAPONS_PANE_POS_X, MAIN_WEAPONS_PANE_POS_Y, MAIN_WEAPONS_PANE_WIDTH, MAIN_WEAPONS_PANE_HEIGHT
        backcolor       0, 0, 0, 0
        textscale       0.2
        visible         1

        windowDef bulletsCategory {
            rect            0, 0, AMMO_CATEGORY_WIDTH, AMMO_CATEGORY_HEIGHT
            backcolor       0, 0, 0, 0
            textscale       0.2

            windowDef weaponPistol {
                rect            WEAP_PANE_1_POS_X, WEAP_PANE_1_POS_Y, WEAP_PANE_WIDTH, WEAP_PANE_HEIGHT
                bordersize      2
                bordercolor     BULLETS_COLOR
                backcolor       NEUTRAL_BAR_BACKGROUND

                onEvent {
                    if ("gui::player_pistol_posession" == 1) {
                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
                    }
                    
                }

                windowDef weaponIcon {
                    rect            WEAP_ICON_POS_X, WEAP_ICON_POS_Y, WEAP_ICON_WIDTH, WEAP_ICON_HEIGHT
                    background      "guis/assets/hud/icons/pistolw"
                    matcolor        BULLETS_COLOR
                }

                windowDef pistolClipFill {
                    rect            WEAP_FILL_POS_X, WEAP_FILL_POS_Y, WEAP_FILL_WIDTH * "gui::player_pistol_clip_ratio", WEAP_FILL_HEIGHT

                    onEvent {
                        if ("gui::player_pistol_clip_ratio" >= LOW_RATIO) {
                            set "backcolor" "$desktop::fullcolor" ;
                        }
                        else if ("gui::player_pistol_clip_ratio" > CRIT_RATIO && "gui::player_pistol_clip_ratio" < LOW_RATIO) {
                            set "backcolor" "$desktop::lowcolor" ;
                        }
                        else if ("gui::player_pistol_clip_ratio" <= CRIT_RATIO) {
                            set "backcolor" "$desktop::critcolor" ;
                        }
                        
                    }
                }

                windowDef pistolClipEmpty {
                    rect            WEAP_FILL_POS_X, WEAP_FILL_POS_Y, WEAP_FILL_WIDTH, WEAP_FILL_HEIGHT
                    backcolor       CRIT_COLOR

                    onEvent {
                        if ("gui::player_pistol_clip" == 0) {
                            set "visible" "1";
                        }
                        else {
                            set "visible" "0";
                        }
                        
                    }
                }

                windowDef pistolClipCount {
                    rect            WEAP_CLIP_COUNT_POS_X, WEAP_CLIP_COUNT_POS_Y, WEAP_CLIP_COUNT_WIDTH, WEAP_CLIP_COUNT_HEIGHT
                    text            "gui::player_pistol_clip"
                    forecolor       BULLETS_COLOR
                    textscale       WEAP_CLIP_COUNT_TEXTSCALE
                    textalign       2

                    onEvent {
                        if ("gui::player_pistol_clip" < 0) {
                            set "visible" "0";
                        }
                        else {
                            set "visible" "1";
                        }
                        
                    }
                }
            }

            windowDef bulletsAmmoBar {
                rect            AMMO_BAR_POS_X, AMMO_BAR_POS_Y, AMMO_BAR_WIDTH, AMMO_BAR_HEIGHT
                backcolor       NEUTRAL_BAR_BACKGROUND
                bordersize      2
                bordercolor     BULLETS_COLOR

