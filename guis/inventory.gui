                    textscale       AMMO_COUNT_TEXTSCALE
                    textalign       2
                    forecolor       BULLETS_COLOR
                }
            }
        }

        windowDef shellsCategory {
            rect            0, AMMO_CATEGORY_STEP_Y, AMMO_CATEGORY_WIDTH, AMMO_CATEGORY_HEIGHT
            backcolor       0, 0, 0, 0
