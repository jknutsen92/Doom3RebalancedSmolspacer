#define FULL_COLOR                  0.345,  0.635,  0.91,   0.5
#define LOW_COLOR                   0.973,  1,      0.463,  0.5
#define CRIT_COLOR                  1,      0.114,  0.114,  0.5

// Matte background colors
#define NEUTRAL_BAR_BACKGROUND      0.8,    0.8,    0.8,    1

// Borders and highlights
#define BULLETS_COLOR               0.518,  0.012,  0.012,  1
#define SHELLS_COLOR                0.29,   0.29,   0.29,   1
#define CLIP_COLOR                  0,      0.455,  0.055,  1
#define GRENADES_COLOR              0.427,  0,      0.514,  1
#define BELT_COLOR                  0.643,  0.302,  0,      1
#define CELLS_COLOR                 0,      0.008,  0.455,  1
#define ROCKETS_COLOR               0.322,  0.137,  0,      1
#define CHAINSAW_COLOR              0.51,   0,      0.231,  1
#define BFG_COLOR                   0.031,  0.522,  0.4,    1
#define SOUL_CUBE_COLOR             0.541,  0.239,  0,      1
#define SECRET_CHAINSAW_COLOR       0.851,  0.212,  0,      1

#define LOW_RATIO                   0.5
#define CRIT_RATIO                  0.20

windowDef Desktop {
    rect            0, 0, 640, 480
    visible         1
    nocursor        1
    backcolor       0, 0, 0, 0
    visible         1

    definevec4  "fullcolor" FULL_COLOR 
    definevec4  "lowcolor"  LOW_COLOR
    definevec4  "critcolor" CRIT_COLOR

    windowDef standardWeapons {
        rect            25, 20, 580, 360
        backcolor       0, 0, 0, 0
        textscale       0.2
        visible         1

        windowDef bulletsCategory {
            rect            0, 0, 580, 48
            backcolor       0, 0, 0, 0
            textscale       0.2

            windowDef weaponPistol {
                rect            64, 2, 60, 44
                bordersize      2
                bordercolor     BULLETS_COLOR
                backcolor       NEUTRAL_BAR_BACKGROUND

                onEvent {
                    if ("gui::player_pistol_posession" == 1) {
                        set "visible" "1";
                    }
                    else {
                        set "visible" "0";
                    }
                    
                }

                windowDef weaponIcon {
                    rect            2, 1, 52, 36
                    background      "guis/assets/hud/icons/pistolw"
                    matcolor        BULLETS_COLOR
                }

                windowDef pistolClipFill {
                    rect            0, 0, 56 * "gui::player_pistol_clip_ratio", 40

                    onEvent {
                        if ("gui::player_pistol_clip_ratio" >= LOW_RATIO) {
                            set "backcolor" "$desktop::fullcolor" ;
                        }
                        else if ("gui::player_pistol_clip_ratio" > CRIT_RATIO && "gui::player_pistol_clip_ratio" < LOW_RATIO) {
                            set "backcolor" "$desktop::lowcolor" ;
                        }
                        else if ("gui::player_pistol_clip_ratio" <= CRIT_RATIO) {
                            set "backcolor" "$desktop::critcolor" ;
                        }
                        
                    }
                }

                windowDef pistolClipEmpty {
                    rect            0, 0, 56, 40
                    backcolor       CRIT_COLOR

                    onEvent {
                        if ("gui::player_pistol_clip" == 0) {
                            set "visible" "1";
                        }
                        else {
                            set "visible" "0";
                        }
                        
                    }
                }

                windowDef pistolClipCount {
                    rect            38, 24, 16, 16
                    text            "gui::player_pistol_clip"
                    forecolor       BULLETS_COLOR
                    textscale       0.25
                    textalign       2

                    onEvent {
                        if ("gui::player_pistol_clip" < 0) {
                            set "visible" "0";
                        }
                        else {
                            set "visible" "1";
                        }
                        
                    }
                }
            }

            windowDef bulletsAmmoBar {
                rect        128, 6, 450, 36
