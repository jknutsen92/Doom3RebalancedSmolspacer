void overheat_burn(entity ent) {
    ent.preBurn();
    ent.burn();
    sys.wait(3);
    ent.remove();
}

boolean _has_clear_line_of_sight_to_player(entity ent, boolean debug) {
    vector entOrigin = ent.getOrigin();
    vector playerOrigin = $player1.getOrigin();
    sys.tracePoint(entOrigin, playerOrigin, CONTENTS_SOLID|CONTENTS_BODY, ent);
    entity result = sys.getTraceEntity();
    if (result == $player1) {
        if (debug) {
            sys.println("Trace test from " + ent.getName() + " succeeded");
        }
        return true;
    }
    if (debug) {
        sys.println("Trace test from " + ent.getName() + " failed. Hit " + result.getName());
    }
    return false;
}

void _pursue_enemy(entity pursuer, entity target, boolean debug) {
    if (debug) {
        sys.println(pursuer.getName() + " pursuing " + target.getName());
    }
    pursuer.setEnemy(target);
    while (pursuer.canReachEnemy()) {
        if (debug) {
            sys.println(pursuer.getName() + " moving to " + target.getName() + "'s postion");
        }
        pursuer.moveToEnemy();
        sys.wait(10);
    }
    if (debug) {
        sys.println(target.getName() + " out of reach of " + pursuer.getName() + ". Self-terminating");
    }
    // TODO: Maybe we can teleport somewhere near the player to jumpscare him, but for now, just remove the entity
    pursuer.remove();
}

void _resurrect_after_delay(entity ent, boolean debug) {
    string name = ent.getName();

    // Determine the resurrection entity
    string classname = sys.getResurrectionClass();
    sys.setSpawnArg("auto_rez", "0");                // Ends the cycle of resurrection if it's a zombie type
    sys.setSpawnArg("classname", classname);

    // Get timer
    float minDelay = sys.parseFloat(sys.getcvar("g_ragdollRezMinDelay"));
    float maxDelay = sys.parseFloat(sys.getcvar("g_ragdollRezMaxDelay"));
    float delayTime = RandomRange(minDelay, maxDelay);

    if (debug) {
        sys.println(name + " spawning rez entity " + classname + " in " + delayTime + " seconds");
    }
    sys.wait(delayTime);

    // Resurrect the entity if it still exists
    entity rezEntity;
    if (uniqueEntityExists(name)) {
        rezEntity = sys.resurrectRagdoll(ent);
        // Send it after the player
        while (rezEntity.isHidden()) {
            sys.waitFrame();
        }
        _pursue_enemy(rezEntity, $player1, debug);
    }
    else if (debug) {
        sys.println(name + " was destroyed before resurrection completed");
    }
}

void auto_resurrect(entity ent) {
    boolean debug = false;
    if (sys.getcvar("g_debugResurrection") == "1") {
        debug = true;
    }
    vector origin = ent.getOrigin();
    vector mins = origin + '-1 -1 0';
    vector maxs = origin + '1 1 0';
    string name = ent.getName();
    while (uniqueEntityExists(name)) {
        // Test for player
        if (debug) {
            sys.println(name + " testing for nearby player");
        }
        if (ent.isPlayerInBounds(mins, maxs)) {
            if (_has_clear_line_of_sight_to_player(ent, debug)) {
                // Yes this is necessary as the doom3 script interpreter doesn't do short circuting boolean statements
                _resurrect_after_delay(ent, debug);
                return;
            }
        }
        sys.wait(5);
    }
    if (debug) {
        sys.println(name + " destroyed. Exiting thread");
    }
}