#define IMP_RUNDISTANCE		108
#define IMP_WALKTURN		65
#define IMP_ATTACK_RATE		0.45
#define IMP_LEAP_RATE		8
#define IMP_LEAP_SPEED		750
#define IMP_LEAP_MAXHEIGHT	48
#define IMP_DODGE_RATE		1
#define IMP_LEAP_RANGE_MIN	200
#define IMP_LEAP_RANGE_MAX	560
#define IMP_NOFOVTIME		1.5

#define IMP_ATTACK_BLEND_FRAMES		5

#define IMP_DMG_DODGE_THRESHOLD			35
#define IMP_DODGE_TELEPORT_THRESHOLD	2
#define IMP_VANISH_TIME					0.25
#define IMP_TELEPORT_TIME				0.5
#define IMP_TELEPORT_DELAY_MIN			1.5
#define IMP_TELEPORT_DELAY_MAX			3.33
#define IMP_TELEPORT_RATE				6.66

#define	ATTACK_TELEPORT			ATTACK_SPECIAL1

object monster_demon_nightmare_imp : monster_base {
	float		nextDodge;
	float		nextAttack;
	float		nextLeap;
	float		nextNoFOVAttack;
	float 		nextTeleport;
	vector		jumpVelocity;
	entity		combat_node;

	string		range_attack_anim;
	string 		teleportFx;
	entity		vanishEffect;

	float		dmgSinceLastDodge;
	float 		dodgesSinceLastTeleport;
	
	// States
	void		state_Begin();
	void		state_Idle();

	// attacks
	float		check_attacks();
	void		do_attack( float attack_flags );
	void		combat_range();
	void		combat_leap();
	void		combat_melee();
	void		combat_dodge_left();
	void		combat_dodge_right();
	void 		combat_teleport();
	void		path_jump();

	void		init();
	void 		PlayVanishFx();
	void 		PlayTeleportFx();
	void 		Teleport();
	
	// torso anim states
	void		Torso_Idle();
	void		Torso_Pain();
	void		Torso_MeleeAttack();
	void		Torso_RangeAttack();
	void		Torso_TurretAttack();
	void		Torso_TurretAttackIdle();
	void		Torso_LeapAttack();
	
	// legs anim states
	void		Legs_Idle();
	void		Legs_Walk();
	void		Legs_Run();
	void		Legs_DodgeLeft();
	void		Legs_DodgeRight();

	// Callback handlers
	void		OnDamage();
};

/***********************************************************************

	Torso animation control

***********************************************************************/

void monster_demon_nightmare_imp::Torso_Idle() {
	idleAnim( ANIMCHANNEL_TORSO, "stand" );
	
	eachFrame {
		if ( AI_PAIN ) { animState( ANIMCHANNEL_TORSO, "Torso_Pain", 3 ); }
	}
}

void monster_demon_nightmare_imp::Torso_Pain() {
	string animname;
	float nextpain;
	float currenttime;
	
	animname = getPainAnim();
	playAnim( ANIMCHANNEL_TORSO, animname );

	nextpain = sys.getTime() + 0.25;
	
	while( !animDone( ANIMCHANNEL_TORSO, 6 ) ) {
		if ( AI_PAIN ) {
			currenttime = sys.getTime();
			if ( currenttime > nextpain ) {
				animState( ANIMCHANNEL_TORSO, "Torso_Pain", 3 );
			}
		}
		waitFrame();
	}

	finishAction( "pain" );
	animState( ANIMCHANNEL_TORSO, "Torso_Idle", 6 );
}

void monster_demon_nightmare_imp::Torso_MeleeAttack() {
	playAnim( ANIMCHANNEL_TORSO, "melee_attack" );

	while( !animDone( ANIMCHANNEL_TORSO, IMP_ATTACK_BLEND_FRAMES ) ) {
		waitFrame();
	}
	
	finishAction( "melee_attack" );
	animState( ANIMCHANNEL_TORSO, "Torso_Idle", IMP_ATTACK_BLEND_FRAMES );
}

void monster_demon_nightmare_imp::Torso_RangeAttack() {
	disablePain();

	playAnim( ANIMCHANNEL_TORSO, range_attack_anim );
	while( !animDone( ANIMCHANNEL_TORSO, IMP_ATTACK_BLEND_FRAMES ) ) {
		lookAtEnemy( 1 );	
		waitFrame();
	}

	allowMovement( true );
	finishAction( "range_attack" );
	animState( ANIMCHANNEL_TORSO, "Torso_Idle", 4 );
}

void monster_demon_nightmare_imp::Torso_TurretAttack() {
	allowMovement( false );
	disablePain();
	faceEnemy();

	playAnim( ANIMCHANNEL_TORSO, "turret_attack" );
	while( !animDone( ANIMCHANNEL_TORSO, IMP_ATTACK_BLEND_FRAMES ) ) {
		waitFrame();
	}

	finishAction( "turret_attack" );
	allowMovement( true );
	animState( ANIMCHANNEL_TORSO, "Torso_TurretAttackIdle", 0 );
}

void monster_demon_nightmare_imp::Torso_TurretAttackIdle() {
	faceEnemy();
	idleAnim( ANIMCHANNEL_TORSO, "turret_idle" );
	while( 1 ) {
		waitFrame();
	}
}

void monster_demon_nightmare_imp::Torso_LeapAttack() {
	overrideAnim( ANIMCHANNEL_LEGS );
	disablePain();
	playAnim( ANIMCHANNEL_TORSO, "jump_start" );
	while( !animDone( ANIMCHANNEL_TORSO, 2 ) ) {
		waitFrame();
	}
	
	setBlendFrames( ANIMCHANNEL_TORSO, 2 );
	attackBegin( "melee_impLeapAttack" );
	setLinearVelocity( jumpVelocity );
	
	playCycle( ANIMCHANNEL_TORSO, "jump_loop" );
	do {
		waitFrame();
	} while( !AI_ONGROUND );
	
	attackEnd();
	playAnim( ANIMCHANNEL_TORSO, "jump_end" );
	while( !animDone( ANIMCHANNEL_TORSO, IMP_ATTACK_BLEND_FRAMES ) ) {
		waitFrame();
	}

	finishAction( "leap_attack" );
	animState( ANIMCHANNEL_TORSO, "Torso_Idle", 4 );
}

/***********************************************************************

	Legs animation control

***********************************************************************/

void monster_demon_nightmare_imp::Legs_Idle() {
	idleAnim( ANIMCHANNEL_LEGS, "stand" );

	eachFrame {
		if ( run && AI_FORWARD )	{ animState( ANIMCHANNEL_LEGS, "Legs_Run", 4 ); }
		if ( AI_FORWARD )			{ animState( ANIMCHANNEL_LEGS, "Legs_Walk", 4 ); }
	}
}

void monster_demon_nightmare_imp::Legs_Walk() {
	playCycle( ANIMCHANNEL_LEGS, "walk" );
	
	eachFrame {
		if ( run && AI_FORWARD )	{ animState( ANIMCHANNEL_LEGS, "Legs_Run", 4 ); }
		if ( !AI_FORWARD )			{ animState( ANIMCHANNEL_LEGS, "Legs_Idle", 4 ); }
	}
}

void monster_demon_nightmare_imp::Legs_Run() {
	playCycle( ANIMCHANNEL_LEGS, "run" );
	
	eachFrame {
		if ( !run && AI_FORWARD )	{ animState( ANIMCHANNEL_LEGS, "Legs_Walk", 4 ); }
		if ( !AI_FORWARD )			{ animState( ANIMCHANNEL_LEGS, "Legs_Idle", 4 ); }
	}
}

void monster_demon_nightmare_imp::Legs_DodgeLeft() {
	playAnim( ANIMCHANNEL_LEGS, "evade_left" );

	while( !animDone( ANIMCHANNEL_LEGS, IMP_ATTACK_BLEND_FRAMES ) ) {
		waitFrame();
	}
	
	finishAction( "strafe" );
	animState( ANIMCHANNEL_LEGS, "Legs_Idle", IMP_ATTACK_BLEND_FRAMES );
}

void monster_demon_nightmare_imp::Legs_DodgeRight() {
	playAnim( ANIMCHANNEL_LEGS, "evade_right" );

	while( !animDone( ANIMCHANNEL_LEGS, IMP_ATTACK_BLEND_FRAMES ) ) {
		waitFrame();
	}

	finishAction( "strafe" );
	animState( ANIMCHANNEL_LEGS, "Legs_Idle", IMP_ATTACK_BLEND_FRAMES );
}

/***********************************************************************

	AI

***********************************************************************/

/*
=====================
monster_demon_nightmare_imp::init
=====================
*/
void monster_demon_nightmare_imp::init() {
	run_distance			= IMP_RUNDISTANCE;
	walk_turn				= IMP_WALKTURN;
	dmgSinceLastDodge 		= 0;
	dodgesSinceLastTeleport	= 0;
	teleportFx				= getKey("fx_teleport");
	// vanishEffect			= NULL;
	thread addSignalFunc(SIG_DAMAGE, self, "monster_demon_nightmare_imp::OnDamage");
	setState( "state_Begin" );
}

/***********************************************************************

	States

***********************************************************************/

/*
=====================
monster_demon_nightmare_imp::state_Begin
=====================
*/
void monster_demon_nightmare_imp::state_Begin() {
	animState( ANIMCHANNEL_TORSO, "Torso_Idle", 0 );
	animState( ANIMCHANNEL_LEGS, "Legs_Idle", 0 );	
	monster_begin();
	setMoveType( MOVETYPE_ANIM );
	setState( "state_Idle" );
}

/*
=====================
monster_demon_nightmare_imp::state_Idle
=====================
*/
void monster_demon_nightmare_imp::state_Idle() {
	wait_for_enemy();

	nextLeap		= RandomTime( IMP_LEAP_RATE );
	nextAttack		= 0;
	nextDodge		= RandomTime( IMP_DODGE_RATE );
	nextNoFOVAttack = 0;
	
	setState( "state_Combat" );
}

/***********************************************************************

	attacks

***********************************************************************/

/*
=====================
monster_demon_nightmare_imp::do_attack
=====================
*/
void monster_demon_nightmare_imp::do_attack( float attack_flags ) {
	nextNoFOVAttack = sys.getTime() + IMP_NOFOVTIME;
	if (attack_flags & ATTACK_TELEPORT) {
		combat_teleport();
	}
	else if ( attack_flags & ATTACK_DODGE_LEFT ) {
		combat_dodge_left();
	} 
	else if ( attack_flags & ATTACK_DODGE_RIGHT ) {
		combat_dodge_right();
	} 
	else if ( attack_flags & ATTACK_COMBAT_NODE ) {
		combat_ainode( combat_node );
	} 
	else if ( attack_flags & ATTACK_MELEE ) {
		combat_melee();
	} 
	else if ( attack_flags & ATTACK_LEAP ) {
		combat_leap();
	} 
	else if ( attack_flags & ATTACK_MISSILE ) {
		combat_range();
	}
}

/*
=====================
monster_demon_nightmare_imp::check_attacks
=====================
*/
float monster_demon_nightmare_imp::check_attacks() {
	float range;
	float currentTime;
	float canMelee;
	float attack_flags;
	float checkLeap;
	vector vel;
	float t;
	string anim;
	vector jumpTarget;
	
	attack_flags = 0;

	if (dodgesSinceLastTeleport > IMP_DODGE_TELEPORT_THRESHOLD || !canSee(getEnemy())) {
		attack_flags |= ATTACK_TELEPORT;
		return attack_flags;
	}
	
	canMelee = testMeleeAttack();
	currentTime = sys.getTime();
	if ( !canMelee ) {
		if ( (AI_PAIN || dmgSinceLastDodge > IMP_DMG_DODGE_THRESHOLD) && ( currentTime >= nextDodge ) ) {
			if ( testAnimMove( "evade_left" ) ) {
				attack_flags |= ATTACK_DODGE_LEFT;
			}
			if ( testAnimMove( "evade_right" ) ) {
				attack_flags |= ATTACK_DODGE_RIGHT;
				
				// if we can dodge either direction, pick one
				if ( attack_flags & ATTACK_DODGE_LEFT ) {
					if ( sys.random( 100 ) < 50 ) {
						attack_flags &= ~ATTACK_DODGE_RIGHT;
					} else {
						attack_flags &= ~ATTACK_DODGE_LEFT;
					}
				}
			}
		}
	
		combat_node = getCombatNode();
		if ( combat_node ) {
			attack_flags |= ATTACK_COMBAT_NODE;
		}
	}

	if ( canMelee ) {
		attack_flags |= ATTACK_MELEE;
	}

	if ( ( ( sys.getTime() > nextNoFOVAttack ) && AI_ENEMY_VISIBLE ) || AI_ENEMY_IN_FOV ) {
		range = enemyRange();
		if ( ( range >= IMP_LEAP_RANGE_MIN ) && ( range < IMP_LEAP_RANGE_MAX ) && ( currentTime >= nextLeap ) ) {
			if ( canHitEnemy() ) {
				t = animLength( ANIMCHANNEL_TORSO, "jump_start" );
				jumpTarget = predictEnemyPos( t );
				jumpVelocity = getJumpVelocity( jumpTarget, IMP_LEAP_SPEED, IMP_LEAP_MAXHEIGHT );
				if ( jumpVelocity != '0 0 0' ) {
					attack_flags |= ATTACK_LEAP;
				} else {
					// check if we can leap again in 2 seconds
					nextLeap = DelayTime( 2 );
				}
			}
		}
		
		if ( !canReachEnemy() || ( currentTime >= nextAttack ) ) {
			range_attack_anim = chooseAnim( ANIMCHANNEL_LEGS, "turret_attack" );
			if ( canHitEnemyFromAnim( range_attack_anim ) ) {
				attack_flags |= ATTACK_MISSILE;
			}

			anim = chooseAnim( ANIMCHANNEL_LEGS, "range_attack" );
			if ( testAnimMoveTowardEnemy( anim ) ) {
				if ( canHitEnemyFromAnim( anim ) ) {
					range_attack_anim = anim;
					attack_flags |= ATTACK_MISSILE;
				}
			}
		}
	}
	
	return attack_flags;
}

/*
=====================
monster_demon_nightmare_imp::combat_range
=====================
*/
void monster_demon_nightmare_imp::combat_range() {
	faceEnemy();
	animState( ANIMCHANNEL_TORSO, "Torso_RangeAttack", IMP_ATTACK_BLEND_FRAMES );
	waitAction( "range_attack" );

	// don't attack for a bit
	nextAttack = DelayTime( IMP_ATTACK_RATE );
	nextNoFOVAttack = sys.getTime() + IMP_NOFOVTIME;
}

/*
=====================
monster_demon_nightmare_imp::combat_leap
=====================
*/
void monster_demon_nightmare_imp::combat_leap() {
	stopMove();
	turnToPos( getOrigin() + jumpVelocity );
	animState( ANIMCHANNEL_TORSO, "Torso_LeapAttack", IMP_ATTACK_BLEND_FRAMES );	
	waitAction( "leap_attack" );
	nextLeap = DelayTime( IMP_LEAP_RATE );
}

/*
=====================
monster_demon_nightmare_imp::combat_melee
=====================
*/
void monster_demon_nightmare_imp::combat_melee() {
	lookAtEnemy( 100 );
	faceEnemy();
	animState( ANIMCHANNEL_TORSO, "Torso_MeleeAttack", IMP_ATTACK_BLEND_FRAMES );
	waitAction( "melee_attack" );
	lookAtEnemy( 1 );
	stopMove();
}

/*
=====================
monster_demon_nightmare_imp::combat_dodge_left
=====================
*/
void monster_demon_nightmare_imp::combat_dodge_left() {
	faceEnemy();
	stopMove();
	dodgesSinceLastTeleport++;
	dmgSinceLastDodge = 0;
	animState( ANIMCHANNEL_LEGS, "Legs_DodgeLeft", IMP_ATTACK_BLEND_FRAMES );
	waitAction( "strafe" );
	nextDodge = DelayTime( IMP_DODGE_RATE );
}

/*
=====================
monster_demon_nightmare_imp::combat_dodge_right
=====================
*/
void monster_demon_nightmare_imp::combat_dodge_right() {
	faceEnemy();
	stopMove();
	dodgesSinceLastTeleport++;
	dmgSinceLastDodge = 0;
	animState( ANIMCHANNEL_LEGS, "Legs_DodgeRight", IMP_ATTACK_BLEND_FRAMES );	
	waitAction( "strafe" );
	nextDodge = DelayTime( IMP_DODGE_RATE );
}

void monster_demon_nightmare_imp::combat_teleport() {
	dodgesSinceLastTeleport = 0;
	dmgSinceLastDodge = 0;
	stopMove();
	enableDamage(0);
	PlayVanishFx();
	hide();
	sys.wait(RandomRange(IMP_TELEPORT_DELAY_MIN, IMP_TELEPORT_DELAY_MAX));
	Teleport();
	enableDamage(1);
	PlayTeleportFx();
	nextTeleport = sys.getTime() + IMP_TELEPORT_RATE;
}

/*
=====================
monster_demon_nightmare_imp::path_jump
=====================
*/
void monster_demon_nightmare_imp::path_jump() {
	entity target;
	vector dir;
	vector jumpTarget;

	// walk to the path entity first
	path_corner();

	if ( checkForEnemy( true ) ) {
		return;
	}

	target = current_path.randomPath();
	if ( !target ) {
		sys.error( "missing target for '" + current_path.getName() + "'" );
	}
	jumpTarget = target.getOrigin();
	if ( !current_path.getKey( "up" ) ) {
		jumpVelocity = getJumpVelocity( jumpTarget, IMP_LEAP_SPEED, 1024 );
		if ( jumpVelocity == '0 0 0' ) {
			sys.error( "Monster '" + getName() + "' couldn't make jump from '" + current_path.getName() + "' to '" + target.getName() + "'" );
		}
	} else {
		float forward = current_path.getFloatKey( "forward" );
		if ( forward <= 0 ) {
			sys.error( "Invalid forward velocity on path_jump entity '" + current_path.getName() + "'\n" );
		}
		dir = jumpTarget - getOrigin();
		dir_z = 0;
		dir = sys.vecNormalize( dir );
		dir = dir * forward;
		dir_z = current_path.getFloatKey( "up" );
		jumpVelocity = dir;
	}
	
	stopMove();
	turnToPos( jumpTarget );
	while( !facingIdeal() ) {
		if ( checkForEnemy( true ) ) {
			return;
		}
		waitFrame();
	}

	animState( ANIMCHANNEL_TORSO, "Torso_LeapAttack", 4 );	
	waitAction( "leap_attack" );

	stopMove();
}

void monster_demon_nightmare_imp::OnDamage() {
	dmgSinceLastDodge = dmgSinceLastDodge + AI_DAMAGE_VALUE;
	AI_DAMAGE_VALUE = 0;
	addSignalFunc(SIG_DAMAGE, self, "monster_demon_nightmare_imp::OnDamage");
}

void monster_demon_nightmare_imp::PlayVanishFx() {
	if (!vanishEffect) {
		vanishEffect = sys.spawn("nightmare_imp_spawneffect");
	}
	startSound("snd_vanish", SND_CHANNEL_VOICE2, false);
	vanishEffect.setOrigin(getOrigin());
	vanishEffect.show();
	vanishEffect.setShaderParm(SHADERPARM_TIMEOFFSET, -sys.getTime());

	preBurn();
	float endTime = sys.getTime() + IMP_VANISH_TIME;
	while (endTime > sys.getTime()) {
		setShaderParm(SHADERPARM_TIME_OF_DEATH, sys.getTime() - ( endTime - sys.getTime() ) * 8);
		waitFrame();
	}
	clearBurn();
	vanishEffect.hide();
}

void monster_demon_nightmare_imp::PlayTeleportFx() {
	show();
	startFx(teleportFx);
	playAnim(ANIMCHANNEL_TORSO, "teleport");
}

void monster_demon_nightmare_imp::Teleport() {
	// TODO get teleport location
	vector destination = '0 0 0';
	destination = pushPointIntoAAS(destination);
	setOrigin(destination);
}